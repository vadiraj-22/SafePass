PORT=5000
MONGODB_URI=mongodb://localhost:27017/safepass
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
ENCRYPTION_KEY=your_super_secret_encryption_key_change_this_in_production_min_32_chars
NODE_ENV=development

# SMTP Email Configuration (Gmail App Password setup using SSL Port 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
EMAIL_FROM="SafePass Security" <your_email@gmail.com>

